# Atelo Hub — environment template.
# Copy to `.env` (untracked) and fill values locally. NEVER paste secrets into chat,
# commits, logs, or issue trackers. See docs/environment.md for how to obtain each
# value, its sensitivity, network limits, and how to validate it safely.

# --- Phase 0: BNB integration reconnaissance ---

# BSC testnet (chainId 97) JSON-RPC endpoint. Optional: public RPC used when unset.
BSC_TESTNET_RPC_URL=

# 8004scan API key. Optional: only needed if anonymous rate limits block ingestion.
SCAN8004_API_KEY=

# Dedicated BSC-testnet-only private key for funding ERC-8183 test jobs.
# Generate locally (see docs/environment.md). NEVER a mainnet or personal wallet key.
TESTNET_DEPLOYER_PRIVATE_KEY=
TESTNET_DEPLOYER_ADDRESS=

# --- Atelo Reference Agent (labs/reference-agent) ---

# Dedicated BSC-testnet-only operator key for the Atelo Reference Agent.
# Generated locally by `labs/reference-agent/scripts/gen_wallet.py` (see
# docs/environment.md). NEVER a mainnet or personal wallet key.
REFERENCE_AGENT_PRIVATE_KEY=
REFERENCE_AGENT_ADDRESS=

# Keystore encryption password used by the SDK's EVMWalletProvider. Local-only.
WALLET_PASSWORD=

# Public base URL of the reference agent, including the /erc8183 prefix.
ERC8183_AGENT_URL=http://127.0.0.1:8003/erc8183

# Public base URL (no path) declared in the ERC-8004 registration. Must be a
# reachable HTTPS host before registering — never a loopback/private address.
REFERENCE_AGENT_PUBLIC_URL=

# Minimum accepted budget in raw payment-token units (1 token at 18 decimals).
ERC8183_SERVICE_PRICE=1000000000000000000

# --- Phase 6: Atelo Reach (notifications + Telegram) ---

# Web Push VAPID keypair. The PUBLIC key is committed in @atelo/core
# (REACH_VAPID_PUBLIC_KEY) and shipped to the browser; keep it in sync here.
# The PRIVATE key is secret and lives only in your local .env. Generate a pair
# with `pnpm exec tsx labs/reach/src/gen-vapid.ts`. See docs/environment.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Telegram bot token from @BotFather. UNSET is fine: the Reach bot runs in an
# offline harness that exercises the same command logic without a live bot.
# Setting a real token is a deliberate user action to go live. See docs/environment.md.
TELEGRAM_BOT_TOKEN=

# Optional HMAC secret for one-time Telegram account-linking deep links.
# A dev default is used when unset; set a strong value before going live.
REACH_LINK_SECRET=

# Optional base URL the app POSTs to for the Reach service (/subscribe push
# subscriptions and /link Telegram deep links). Defaults to http://localhost:8787.
EXPO_PUBLIC_REACH_URL=

# Optional TCP port for the Reach HTTP server (labs/reach/src/serve.ts). Default 8787.
REACH_PORT=

# Optional Postgres URL. Shared by the Phase 4 lineage metric store and the Phase 6
# Reach link store (persists Telegram chat↔wallet links + per-wallet pause). Both
# skip cleanly to in-memory when unset. Embeds a DB password — keep out of git.
DATABASE_URL=
